{
  "name": "sapere-e-potere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Party quiz game multiplayer in stile PlayLink: schermo principale 3D + smartphone come controller.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./client --ignore ./dist server/index.ts",
    "build": "vite build",
